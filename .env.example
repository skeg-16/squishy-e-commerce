# Neon pooled connection; never expose this in browser JavaScript.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Exact public origin, without a trailing slash.
APP_ORIGIN=http://localhost:3000
PORT=3000
# Simulations are disabled unless explicitly enabled. No real money is handled.
DEMO_MODE=true
# Optional DISPOSABLE PostgreSQL database whose name must include "test".
# Otherwise npm test starts an isolated embedded PostgreSQL instance.
# TEST_DATABASE_URL=postgresql://localhost/squishies_test
