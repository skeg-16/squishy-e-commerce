# Neon pooled connection; never expose this in browser JavaScript.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Exact public origin, without a trailing slash.
APP_ORIGIN=http://localhost:3000
PORT=3000
# Simulations are disabled unless explicitly enabled. No real money is handled.
DEMO_MODE=true
# Optional DISPOSABLE PostgreSQL database whose name must include "test".
# Otherwise npm test starts an isolated embedded PostgreSQL instance.
# TEST_DATABASE_URL=postgresql://localhost/squishies_test
# Admin dashboard (/admin.html). Required to log in; at least 8 characters. Never commit the real value.
ADMIN_PASSWORD=change-me-please
# Optional: signing key for admin session cookies. Defaults to a key derived from ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET=long-random-string
