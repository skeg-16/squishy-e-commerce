# ==============================================================================
# SQUISHIES E-COMMERCE - VERCEL & PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. DATABASE CONNECTION (Required on Vercel):
# Connect a free cloud PostgreSQL instance (Neon, Supabase, or Vercel Postgres).
# Neon: https://neon.tech (Recommended, 100% free serverless Postgres)
# Vercel Storage: In Vercel Project Dashboard -> Storage -> Create Database -> Postgres
DATABASE_URL=postgresql://USER:PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. APPLICATION ORIGIN (Optional on Vercel, defaults to *.vercel.app):
# The canonical public URL of your deployed website (no trailing slash).
APP_ORIGIN=https://squishy-e-commerce.vercel.app

# 3. DEMO & SIMULATION MODE (Recommended for academic demo / school project):
# Enables simulated GCash payments, instant delivery progression, and demo vouchers.
DEMO_MODE=true

# 4. PORT (Used when running server locally outside Vercel):
PORT=3000

# 5. BREVO EMAIL RECEIPT SETUP (Optional but recommended for order confirmation emails):
# Get free credentials at https://www.brevo.com (300 free emails/day)
#
# Option A: Brevo API Key (Recommended for Vercel Serverless Functions)
# In Brevo: Go to Settings -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=xkeysib-YOUR_BREVO_API_KEY_HERE
BREVO_SENDER_EMAIL=your-verified-brevo-email@gmail.com
BREVO_SENDER_NAME="SISO Squishies Collective"

# Option B: Brevo SMTP Relay (Standard SMTP)
# In Brevo: Go to Settings -> SMTP & API -> SMTP tab
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@gmail.com
SMTP_PASS=xsmtpsib-YOUR_SMTP_KEY_HERE
SMTP_FROM=your-verified-brevo-email@gmail.com

# 6. TEST DATABASE (Optional for local testing with a disposable cloud database):
# TEST_DATABASE_URL=postgresql://localhost/squishies_test

# 6. BREVO TRANSACTIONAL EMAIL (RECEIPTS):
# Generates and sends styled pastel order receipts for COD and prepaid orders.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME="SISO Squishies Collective"

# 7. BREVO SMTP RELAY (Alternative):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@smtp-brevo.com
SMTP_FROM=your_verified_sender@example.com


